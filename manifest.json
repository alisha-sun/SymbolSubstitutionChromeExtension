{
    "manifest_version": 3,
    "name": "text completion extension",
    "version": "1",
    "description": "for people tired of copy-pasting math symbols and emojis from google (:",
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
    	    "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}